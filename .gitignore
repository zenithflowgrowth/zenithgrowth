# Dependencies
node_modules/
*/node_modules/

# OS-specific binaries (Linux cloud servers auto-install yt-dlp & ffmpeg via package.json)
bin/*.exe
*/bin/*.exe

# Downloaded media files
downloads/*
!downloads/.gitkeep
universal-video-downloader/downloads/*
!universal-video-downloader/downloads/.gitkeep

# Archives & temporary data
*.zip
scratch/
READY-FOR-GITHUB/
*.log
.DS_Store
Thumbs.db

# Secrets & Credentials Protection (Prevents accidental leak)
.env
.env.*
*.env
*.pem
*.key
*.cert
*.crt
id_rsa
id_ed25519
credentials.json
client_secret*.json
*.token
*.p12
*.pfx

